# HTTP Server
HTTP_PORT=8081
HTTP_IP_HEADER=
ENVIRONMENT=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=unibo_user
DB_PASS=unibo_pass
DB_NAME=unibo_toolkit
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=3600000000000
DB_MAX_CONN_IDLE_TIME=1800000000000

# OIDC provider
OIDC_ISSUER=https://auth.uniplanner.it
OIDC_UI_BASE_URL=http://localhost:8081/dev
OIDC_API_AUDIENCE=uniplanner-api
# Private RSA PEM keys separated by ;;. The first key signs new tokens.
# Literal \n sequences are accepted inside each PEM.
JWT_SIGNING_KEYS="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
AUTH_REQUEST_TTL=10m
AUTH_CODE_TTL=60s

# SSO session
SESSION_COOKIE_NAME=__Host-uniplanner_sid
SESSION_ABSOLUTE_TTL=720h
SESSION_IDLE_TTL=336h

# OAuth Providers
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URL=https://uniplanner.it/api/v1/auth/google/callback

APPLE_CLIENT_ID=it.uniplanner.signin
APPLE_TEAM_ID=XXX
APPLE_KEY_ID=XXX
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URL=https://uniplanner.it/api/v1/auth/apple/callback

# Logging
LOG_LEVEL=info
