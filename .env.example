# HTTP Server
HTTP_PORT=8081
HTTP_IP_HEADER=
ENVIRONMENT=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=unibo_user
DB_PASS=unibo_pass
DB_NAME=unibo_toolkit
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=3600000000000
DB_MAX_CONN_IDLE_TIME=1800000000000

# JWT Configuration
# Note: These should be PEM-encoded RSA keys as strings
# You can use \\n for newlines or actual newlines depending on your .env file format
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"
JWT_ISSUER=uniplanner.it
JWT_AUDIENCE=uniplanner.it
JWT_KID=key-2026-01
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# OAuth Providers
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URL=https://uniplanner.it/api/v1/auth/google/callback

APPLE_CLIENT_ID=it.uniplanner.signin
APPLE_TEAM_ID=XXX
APPLE_KEY_ID=XXX
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URL=https://uniplanner.it/api/v1/auth/apple/callback

# Logging
LOG_LEVEL=info
